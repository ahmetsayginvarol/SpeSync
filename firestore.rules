rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isRestaurant() {
      return hasRole('restaurant') || isAdmin();
    }

    function isGalley() {
      return hasRole('galley') || isAdmin();
    }

    // Users collection — admins manage, users can read own doc
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Venues — all signed-in can read, admin writes
    match /venues/{venueId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Allergies — all signed-in can read, admin writes
    match /allergies/{allergyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // App config — all signed-in can read, admin writes
    match /appConfig/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Voyages
    match /voyages/{voyageId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;

      // Guests — restaurant & admin write, galley reads
      match /guests/{guestId} {
        allow read: if isSignedIn();
        allow write: if isRestaurant();
      }

      // Preorders — restaurant writes/edits, galley can update chef fields
      match /preorders/{preorderId} {
        allow read: if isSignedIn();
        allow create: if isRestaurant();
        allow update: if isRestaurant() || (
          isGalley() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['chef_flag', 'chef_remark'])
        );
        allow delete: if isRestaurant();
      }
    }
  }
}
